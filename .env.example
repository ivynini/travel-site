# 复制本文件为 .env.local 后填写真实值（.env.local 已被 .gitignore 忽略，不会提交）
# ！！！不要把真实 Key 直接写进代码或提交到仓库！！！

# ── 后端（server.cjs） ──
# 大模型服务地址与模型名，兼容任何 OpenAI 协议的服务
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 在 https://platform.deepseek.com 申请
AI_API_KEY=
# 上游请求超时（毫秒）
AI_TIMEOUT_MS=30000
# 工具调用轮数：1=只查一次数据，3=可连续「搜索→估算→看详情」（上限 5）
AI_MAX_TOOL_ROUNDS=3
# 后端监听端口
PORT=3000
# 生产环境允许跨域的前端域名，多个用逗号分隔（本地 localhost 已默认放行）
CORS_ORIGINS=

# ── 前端（Vite） ──
# 开发环境留空即可，请求会经 Vite 代理转发到 http://localhost:3000
# 部署到线上时填后端完整地址，例如 https://api.example.com
VITE_API_BASE_URL=